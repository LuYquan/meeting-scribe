# Firebase web config — copy to `.env` and fill in real values.
# Get these from the Firebase console: Project settings → Your apps → Web app.
# NEVER commit a real `.env` file. These placeholders intentionally do NOT work.
VITE_FIREBASE_API_KEY=YOUR_API_KEY
VITE_FIREBASE_AUTH_DOMAIN=YOUR_PROJECT_ID.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=YOUR_PROJECT_ID
VITE_FIREBASE_STORAGE_BUCKET=YOUR_PROJECT_ID.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=YOUR_MESSAGING_SENDER_ID
VITE_FIREBASE_APP_ID=YOUR_APP_ID

# Optional: reCAPTCHA v3 site key for App Check (Firebase console → App Check).
# Leave empty to skip App Check init (works when enforcement is off in console).
VITE_FIREBASE_RECAPTCHA_SITE_KEY=

# Optional: set to "true" to enable the App Check debug provider (local dev).
# Debug tokens are accepted for #BuildHybridAI submissions. When enabled, the
# debug token is printed in the browser console — register it in the Firebase
# console under App Check → Apps → Manage debug tokens.
VITE_FIREBASE_APPCHECK_DEBUG_TOKEN=
